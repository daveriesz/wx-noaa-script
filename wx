#!/bin/bash

wx_location=
wx_do_conditions=0
wx_do_forecast=0
wx_do_hourly=0
wx_do_forecast_long=0
wx_do_forecast_short=0
wx_do_temp=0

debug=0

while [ $# -gt 0 ] ; do
  case $1 in
    -g|--debug) debug=1 ;;
    -c)  wx_do_conditions=1 ;;
    -f)  wx_do_forecast=1 ;;
    -fs) wx_do_forecast=1 ; wx_do_forecast_short=1 ;;
    -fl) wx_do_forecast=1 ; wx_do_forecast_long=1 ;;
    -h)  wx_do_hourly=1 ;;
    -t)  wx_do_temp=1 ;;
    *)
      if [ "$wx_location" = "" ] ; then
        wx_location="$1"
      else
        wx_location="${wx_location} $1"
      fi
      ;;
  esac
  shift
done

if [ $((wx_do_conditions+wx_do_forecast+wx_do_hourly+wx_do_temp)) -eq 0 ] ; then
  wx_do_conditions=1
  wx_do_forecast=1
#  wx_do_hourly=1
fi

if [ $debug -ne 0 ] ; then
  exec 3>&2
else
  exec 3>/dev/null
fi

longest()
{
  ll=0
  while read aa ; do
    if [ ${#aa} -gt $ll ] ; then
      ll=${#aa}
    fi
  done
  echo $ll
}

loccache="${HOME}/.wx-loc-cache"
locdata=
locname=
getloc()
{
  echo "getloc $1" >&3
  local cached=0
  if [ -f "$loccache" ] ; then
    locdata=$(jq -rc '. | select(.loc | test("^'"$1"'$"; "i"))' <"$loccache" | head -1)
    if [ "$locdata" ] ; then
      cached=1
      echo "   cached: $1" >&3
      echo "           $locdata" >&3
      echo "$locdata" | jq -c .
    fi
  else
    touch "$loccache"
  fi

  if [ $cached -eq 0 ] ; then
    locdata=$( \
      curl -sG "https://nominatim.openstreetmap.org/search" \
        -H 'User-Agent: wx-script/1.0 (dpr-wx-script@riesz.net)' \
        --data-urlencode "q=$1" \
        --data-urlencode "format=json" \
        --data-urlencode "limit=1" \
        --data-urlencode "countrycodes=us" \
      | jq -c '.[0]'
    )
    echo "$locdata" | jq -c '. += {"loc":"'"$1"'"}' | tee -a "$loccache"
  fi
}

coords()
{
  echo "coords($1)" >&3
  locdata=$(getloc "$1")
  echo "coords() $1 : $locdata" >&3
  IFS='|' read ll locname < <(jq -r '. | "\(.lat),\(.lon)|\(.name)"' <<<"$locdata")
  if [ "$ll" != "" ] ; then
    echo "$ll"
  fi
}

fwb=211.97
cwb=100.00
fwf=32.00
cwf=0.00
temptoF()
{
  IFS='|' read v u < <(jq -r '. | "\(.value)|\(.unitCode)"' <<<"$1")
  if [ "$v" = null ] ; then
    echo null
  else
    v2=$(echo "1k $fwb $fwf - $cwb $cwf - / $v * 32.00 + p q" | dc | sed "s/\(\.[0-9]\)[0-9]*$/\1/g")
    printf "%s \u00b0F" "$v2"
  fi
}

pahg=0.00029529983
presstoInHg()
{
  IFS='|' read v u < <(jq -r '. | "\(.value)|\(.unitCode)"' <<<"$1")
  if [ "$v" = null ] ; then
    echo null
  else
    v2=$(echo "1k $v $pahg * p q" | dc | sed "s/\(\.[0-9]\)[0-9]*$/\1/g")
    printf "%s in-Hg" "$v2"
  fi
}

pcttoStr()
{
  IFS='|' read v u < <(jq -r '. | "\(.value)|\(.unitCode)"' <<<"$1")
  if [ "$v" = null ] ; then
    echo null
  else
    v2=$(sed "s/\.[0-9]*$//g" <<<"$v")
    printf "%s %%" "$v2"
  fi
}

degtoStr()
{
  IFS='|' read v u < <(jq -r '. | "\(.value)|\(.unitCode)"' <<<"$1")
  if [ "$v" = null ] ; then
    echo null
  else
    printf "%s \u00b0" "$v"
  fi
}

